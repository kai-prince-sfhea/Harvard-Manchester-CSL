<?xml version='1.0' encoding='utf-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-GB" page-range-format="expanded" demote-non-dropping-particle="never">
  <!-- Original style used the Visual CSL Editor. Subsequent local maintenance is described in README.md. -->
  <info>
    <title>Harvard Manchester</title>
    <id>http://www.zotero.org/styles/harvard-manchester</id>
    <link rel="self" href="http://www.zotero.org/styles/harvard-manchester"/>
    <author>
      <name>Adrian Kosikowski</name>
    </author>
    <contributor>
      <name>Lea Anderton</name>
    </contributor>
    <contributor>
      <name>David Hirst</name>
    </contributor>
    <contributor>
      <name>Dhruv Mistry</name>
    </contributor>
    <contributor>
      <name>Preenal Asher</name>
    </contributor>
    <contributor>
      <name>Kai Prince</name>
    </contributor>
    <summary>Local October 2026 development candidate; original credits retained. See README for data contracts and acceptance limits.</summary>
    <updated>2026-10-14T00:00:00+00:00</updated>
    <rights>University material: (c) 2024 The University of Manchester, all rights reserved. See https://www.manchester.ac.uk/copyright/ for the copyright notice. No open licence is asserted.</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="open-quote">‘</term>
      <term name="close-quote">’</term>
      <term name="open-inner-quote">“</term>
      <term name="close-inner-quote">”</term>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="edition" form="short">edn.</term>
      <term name="no date">no date</term>
      <term name="circa" form="short">ca.</term>
    </terms>
  </locale>
  <!-- Names, dates and titles remain bibliographic facts supplied by the author. -->
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=". " name-as-sort-order="all"/>
      <substitute>
        <!-- A parent-volume editor or interviewer is not the missing creator. -->
        <choose>
          <if type="book classic" match="any">
            <names variable="editor">
              <name and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=". " name-as-sort-order="all"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
          </if>
          <else-if type="song musical_score collection" match="any">
            <names variable="composer"/>
          </else-if>
        </choose>
        <text macro="author-title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-citation">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" initialize-with=". "/>
      <substitute>
        <choose>
          <if type="book classic" match="any">
            <names variable="editor"/>
          </if>
          <else-if type="song musical_score collection" match="any">
            <names variable="composer"/>
          </else-if>
          <!-- The Library's film example cites the director, but leads its reference with the title. -->
          <else-if type="motion_picture broadcast" match="any">
            <names variable="director"/>
          </else-if>
        </choose>
        <text macro="citation-title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-title">
    <choose>
      <if type="article-newspaper" variable="container-title" match="all">
        <text variable="container-title" font-style="italic"/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="citation-title">
    <choose>
      <if type="legislation" variable="title-short" match="all">
        <text variable="title-short" font-style="italic"/>
      </if>
      <else-if type="entry-encyclopedia legal_case" match="any">
        <text variable="title" quotes="true"/>
      </else-if>
      <else>
        <text macro="author-title"/>
      </else>
    </choose>
  </macro>
  <macro name="creator-sort">
    <names variable="author">
      <name name-as-sort-order="all"/>
      <substitute>
        <choose>
          <if type="book classic" match="any">
            <names variable="editor"/>
          </if>
          <else-if type="song musical_score collection" match="any">
            <names variable="composer"/>
          </else-if>
        </choose>
        <text macro="author-title"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-sort">
    <choose>
      <if type="legislation legal_case entry-encyclopedia motion_picture" match="any">
        <text variable="title"/>
      </if>
      <else-if type="broadcast">
        <choose>
          <if variable="author">
            <text macro="creator-sort"/>
          </if>
          <else>
            <text variable="title"/>
          </else>
        </choose>
      </else-if>
      <else>
        <text macro="creator-sort"/>
      </else>
    </choose>
  </macro>
  <macro name="year-sort">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="year">
    <choose>
      <if variable="issued">
        <group delimiter=" ">
          <text macro="issued-uncertainty"/>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <text term="no date"/>
      </else>
    </choose>
  </macro>
  <macro name="issued-uncertainty">
    <choose>
      <if is-uncertain-date="issued">
        <text term="circa" form="short"/>
      </if>
    </choose>
  </macro>
  <macro name="date-full">
    <group delimiter=" ">
      <text macro="issued-uncertainty"/>
      <date variable="issued" delimiter=" ">
        <date-part name="day" form="numeric-leading-zeros"/>
        <date-part name="month"/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>
  <macro name="date-day-month">
    <!-- Uncertainty is already retained with the reference's year. -->
    <date variable="issued" delimiter=" ">
      <date-part name="day" form="numeric-leading-zeros"/>
      <date-part name="month"/>
    </date>
  </macro>
  <macro name="event-date">
    <date variable="event-date" delimiter=" ">
      <date-part name="day"/>
      <date-part name="month"/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>
  <macro name="part-title">
    <text variable="title" quotes="true"/>
  </macro>
  <macro name="edition">
    <!-- Standard CSL cannot test equality with 1 or arbitrary strings. Omit first editions in input; use 'rev' for revised. -->
    <group delimiter=" ">
      <number variable="edition" form="ordinal"/>
      <text term="edition" form="short"/>
    </group>
  </macro>
  <macro name="medium">
    <text variable="medium" prefix="[" suffix="]"/>
  </macro>
  <macro name="description">
    <choose>
      <if variable="medium">
        <text macro="medium"/>
      </if>
      <else>
        <text variable="genre" prefix="[" suffix="]"/>
      </else>
    </choose>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="provider">
    <choose>
      <if variable="archive">
        <text variable="archive" font-style="italic"/>
      </if>
      <else>
        <text variable="source" font-style="italic"/>
      </else>
    </choose>
  </macro>
  <macro name="page">
    <group delimiter=" ">
      <choose>
        <if is-numeric="page">
          <label variable="page" form="short"/>
        </if>
      </choose>
      <text variable="page"/>
    </group>
  </macro>
  <macro name="locator">
    <group delimiter=" ">
      <choose>
        <if locator="page">
          <choose>
            <if is-numeric="locator">
              <label variable="locator" form="short"/>
            </if>
          </choose>
        </if>
        <else>
          <label variable="locator" form="short"/>
        </else>
      </choose>
      <text variable="locator"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <!-- Supply a bare lowercase DOI; CSL does not strip an existing URL prefix. -->
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <group delimiter=" ">
          <text variable="URL" prefix="Available at: "/>
          <date variable="accessed" prefix="(Accessed: " suffix=")" delimiter=" ">
            <date-part name="day" form="numeric-leading-zeros"/>
            <date-part name="month"/>
            <date-part name="year"/>
          </date>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="translator">
    <names variable="translator" prefix="Translated by ">
      <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
    </names>
  </macro>
  <macro name="book">
    <group delimiter=". ">
      <text macro="title"/>
      <text variable="collection-title" font-style="italic"/>
      <text macro="translator"/>
      <choose>
        <if variable="author">
          <names variable="editor" prefix="Edited by ">
            <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=". "/>
          </names>
        </if>
      </choose>
      <text macro="edition"/>
      <text macro="description"/>
      <text macro="publisher"/>
      <text macro="provider"/>
    </group>
  </macro>
  <macro name="chapter">
    <group delimiter=". ">
      <group delimiter=", ">
        <text macro="part-title"/>
        <group prefix="in " delimiter=" ">
          <text macro="editors"/>
          <text variable="container-title" font-style="italic"/>
        </group>
      </group>
      <text macro="edition"/>
      <group delimiter=", ">
        <text macro="publisher"/>
        <text macro="page"/>
      </group>
    </group>
  </macro>
  <macro name="article">
    <group delimiter=". ">
      <group delimiter=", ">
        <choose>
          <if variable="container-title">
            <text macro="part-title"/>
          </if>
          <else>
            <text macro="title"/>
          </else>
        </choose>
        <text variable="container-title" font-style="italic"/>
        <group delimiter=" ">
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
        </group>
        <choose>
          <if variable="page">
            <text macro="page"/>
          </if>
          <else>
            <text variable="number"/>
          </else>
        </choose>
      </group>
      <text variable="status"/>
      <text macro="description"/>
      <text macro="provider"/>
    </group>
  </macro>
  <macro name="report">
    <group delimiter=". ">
      <group delimiter=" ">
        <text macro="title"/>
        <text variable="number" prefix="(" suffix=")"/>
      </group>
      <text macro="publisher"/>
      <text macro="description"/>
      <text variable="version" prefix="Version "/>
      <text variable="dimensions"/>
      <group delimiter=" ">
        <number variable="number-of-pages"/>
        <label variable="number-of-pages" form="short"/>
      </group>
      <text macro="page"/>
      <text macro="provider"/>
      <text variable="note"/>
      <text variable="status"/>
    </group>
  </macro>
  <macro name="programme-venue">
    <group delimiter=": ">
      <choose>
        <if variable="event-title">
          <text variable="event-title"/>
        </if>
        <else>
          <text variable="publisher"/>
        </else>
      </choose>
      <choose>
        <if variable="event-place">
          <text variable="event-place"/>
        </if>
        <else>
          <text variable="publisher-place"/>
        </else>
      </choose>
    </group>
  </macro>
  <macro name="document-title">
    <choose>
      <if variable="collection-title">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="part-title"/>
            <text macro="description"/>
          </group>
          <text variable="collection-title" font-style="italic"/>
        </group>
      </if>
      <else-if variable="container-title">
        <group delimiter=". ">
          <group delimiter=", ">
            <text macro="part-title"/>
            <group prefix="in " delimiter=" ">
              <names variable="editor">
                <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
              </names>
              <text variable="container-title" font-style="italic"/>
            </group>
          </group>
          <text macro="event-date"/>
          <text macro="description"/>
        </group>
      </else-if>
      <else-if variable="event-date">
        <group delimiter=", ">
          <text macro="title"/>
          <text macro="event-date"/>
          <text macro="description"/>
        </group>
      </else-if>
      <else-if type="personal_communication">
        <group delimiter=" ">
          <text macro="part-title"/>
          <text macro="description"/>
        </group>
      </else-if>
      <else>
        <group delimiter=" ">
          <text macro="title"/>
          <text macro="description"/>
        </group>
      </else>
    </choose>
  </macro>
  <macro name="document">
    <group delimiter=". ">
      <text macro="document-title"/>
      <choose>
        <if variable="collection-title">
          <group delimiter=". ">
            <text variable="event-title"/>
            <text macro="event-date"/>
            <text variable="event-place"/>
            <text macro="publisher"/>
            <text macro="page"/>
          </group>
        </if>
        <else-if variable="event-date">
          <group delimiter=", ">
            <text macro="programme-venue"/>
            <text macro="page"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text variable="event-title"/>
            <text variable="event-place"/>
            <text macro="publisher"/>
            <text macro="page"/>
          </group>
        </else>
      </choose>
      <text variable="number"/>
      <text variable="note"/>
      <text variable="status"/>
    </group>
  </macro>
  <macro name="media">
    <group delimiter=". ">
      <text macro="title"/>
      <text variable="container-title" font-style="italic"/>
      <names variable="director" prefix="Directed by ">
        <name and="text" delimiter=", " delimiter-precedes-last="never" name-as-sort-order="all" initialize-with=". "/>
      </names>
      <text macro="description"/>
      <text macro="date-day-month"/>
      <text macro="publisher"/>
    </group>
  </macro>
  <!-- Collapsing by author can regroup nonadjacent years and violate chronological order. -->
  <citation et-al-min="4" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="all-names">
    <sort>
      <key macro="year-sort"/>
      <key macro="author-sort"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <choose>
        <!-- The Act's complete title already contains its year. -->
        <if type="legislation">
          <choose>
            <!-- An authored year-free short title enables native year-only citation modes. -->
            <if variable="title-short">
              <group delimiter=", ">
                <group delimiter=" ">
                  <text macro="author-citation"/>
                  <text macro="year"/>
                </group>
                <text macro="locator"/>
              </group>
            </if>
            <else>
              <group delimiter=", ">
                <text macro="author-citation"/>
                <text macro="locator"/>
              </group>
            </else>
          </choose>
        </if>
        <else>
          <group delimiter=", ">
            <text macro="author-citation"/>
            <text macro="year"/>
            <text macro="locator"/>
          </group>
        </else>
      </choose>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="1" entry-spacing="0" hanging-indent="true">
    <!-- Year-only sort avoids month/title order changing first-citation suffixes. -->
    <sort>
      <key macro="author-sort"/>
      <key macro="year-sort"/>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <choose>
          <if type="legislation">
            <text macro="title"/>
          </if>
          <else>
            <group delimiter=" ">
              <choose>
                <if type="motion_picture">
                  <text macro="title"/>
                </if>
                <else-if type="broadcast">
                  <choose>
                    <if variable="author">
                      <text macro="author"/>
                    </if>
                    <else>
                      <text macro="title"/>
                    </else>
                  </choose>
                </else-if>
                <else-if type="legal_case">
                  <text macro="part-title"/>
                </else-if>
                <else-if type="entry-encyclopedia">
                  <text macro="part-title"/>
                </else-if>
                <else-if type="personal_communication">
                  <text macro="author" prefix="[" suffix="]"/>
                </else-if>
                <else>
                  <text macro="author"/>
                </else>
              </choose>
              <text macro="year" prefix="(" suffix=")"/>
            </group>
          </else>
        </choose>
        <choose>
          <if type="legislation"/>
          <else-if type="book classic" match="any">
            <text macro="book"/>
          </else-if>
          <else-if type="chapter entry-dictionary" match="any">
            <text macro="chapter"/>
          </else-if>
          <else-if type="entry-encyclopedia">
            <text variable="container-title" font-style="italic"/>
          </else-if>
          <else-if type="entry">
            <group delimiter=", ">
              <text macro="part-title"/>
              <text variable="container-title" font-style="italic"/>
              <text macro="provider"/>
            </group>
          </else-if>
          <else-if type="article-journal article-magazine article review review-book" match="any">
            <text macro="article"/>
          </else-if>
          <else-if type="post-weblog article-newspaper" match="any">
            <group delimiter=", ">
              <text macro="part-title"/>
              <text variable="container-title" font-style="italic"/>
              <text variable="edition"/>
              <text macro="date-full"/>
              <text macro="page"/>
            </group>
          </else-if>
          <else-if type="report">
            <text macro="report"/>
          </else-if>
          <else-if type="standard">
            <group delimiter=". ">
              <group delimiter=": ">
                <text variable="number"/>
                <text macro="title"/>
              </group>
              <text macro="description"/>
              <text macro="publisher"/>
            </group>
          </else-if>
          <else-if type="thesis">
            <group delimiter=". ">
              <text macro="title"/>
              <group delimiter=", ">
                <text variable="genre"/>
                <text variable="publisher"/>
              </group>
              <text variable="archive" font-style="italic"/>
            </group>
          </else-if>
          <else-if type="patent">
            <group delimiter=". ">
              <text macro="title"/>
              <text variable="number" prefix="Patent no. "/>
              <text variable="authority"/>
              <text variable="source" font-style="italic"/>
            </group>
          </else-if>
          <else-if type="paper-conference">
            <group delimiter=". ">
              <group delimiter=", ">
                <text macro="part-title"/>
                <text variable="container-title" font-style="italic"/>
                <text variable="event-title"/>
                <text variable="event-place"/>
              </group>
              <text macro="event-date"/>
              <text macro="publisher"/>
              <text macro="page"/>
            </group>
          </else-if>
          <else-if type="broadcast motion_picture" match="any">
            <choose>
              <if type="broadcast" variable="author" match="all">
                <text macro="media"/>
              </if>
              <else>
                <group delimiter=". ">
                  <names variable="director" prefix="Directed by ">
                    <name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with=". " name-as-sort-order="all"/>
                  </names>
                  <text macro="description"/>
                  <text macro="publisher"/>
                </group>
              </else>
            </choose>
          </else-if>
          <else-if type="song musical_score collection" match="any">
            <group delimiter=". ">
              <choose>
                <if variable="container-title">
                  <group delimiter=", ">
                    <text macro="part-title"/>
                    <text variable="container-title" font-style="italic"/>
                  </group>
                </if>
                <else>
                  <text macro="title"/>
                </else>
              </choose>
              <text macro="description"/>
              <text macro="publisher"/>
            </group>
          </else-if>
          <else-if type="post">
            <group delimiter=". ">
              <group delimiter=" ">
                <text macro="title"/>
                <text macro="description"/>
              </group>
              <text variable="note"/>
              <text macro="date-full"/>
            </group>
          </else-if>
          <else-if type="software">
            <group delimiter=". ">
              <group delimiter=" " font-style="italic">
                <text variable="title"/>
                <text variable="version" prefix="(version " suffix=")"/>
              </group>
              <text macro="description"/>
            </group>
          </else-if>
          <else-if type="legal_case">
            <group delimiter=". ">
              <text variable="authority"/>
              <text variable="number" prefix="Case: "/>
              <text variable="archive" font-style="italic"/>
            </group>
          </else-if>
          <else-if type="map">
            <group delimiter=". ">
              <text macro="title"/>
              <text variable="scale"/>
              <text variable="container-title" font-style="italic"/>
              <text variable="source" prefix="Using: "/>
              <text variable="archive" font-style="italic"/>
              <text macro="publisher"/>
            </group>
          </else-if>
          <else-if type="graphic figure" match="any">
            <group delimiter=". ">
              <group delimiter=" ">
                <text macro="title"/>
                <text macro="description"/>
              </group>
              <text variable="container-title" font-style="italic"/>
              <text macro="page"/>
              <text macro="publisher"/>
              <text macro="provider"/>
            </group>
          </else-if>
          <else-if type="interview">
            <group delimiter=". ">
              <text macro="part-title"/>
              <text macro="description"/>
              <names variable="author" prefix="Interview with ">
                <name and="text" delimiter=", " initialize-with=". " name-as-sort-order="all"/>
              </names>
              <names variable="interviewer" prefix="Interviewed by ">
                <name and="text" delimiter=", " initialize-with=". " name-as-sort-order="all"/>
              </names>
              <text variable="container-title" font-style="italic"/>
              <text macro="publisher"/>
              <choose>
                <if variable="event-date">
                  <text macro="event-date"/>
                </if>
                <else>
                  <text macro="date-full"/>
                </else>
              </choose>
              <text macro="page"/>
              <text variable="event-place"/>
              <text variable="note"/>
              <text variable="status"/>
            </group>
          </else-if>
          <else-if type="manuscript">
            <group delimiter=". ">
              <text macro="title"/>
              <text variable="collection-title"/>
              <text variable="archive_collection"/>
              <text macro="description"/>
              <group prefix="At: " delimiter=", ">
                <text variable="archive"/>
                <text variable="archive-place"/>
              </group>
              <text variable="call-number"/>
              <text variable="archive_location"/>
              <text variable="number"/>
              <text variable="page"/>
              <text variable="note"/>
              <text variable="publisher"/>
              <text variable="status"/>
            </group>
          </else-if>
          <else-if type="dataset">
            <group delimiter=". ">
              <text macro="title"/>
              <text macro="description"/>
              <text variable="version" prefix="Version "/>
              <text macro="publisher"/>
              <text macro="provider"/>
            </group>
          </else-if>
          <else-if type="webpage">
            <text macro="title"/>
          </else-if>
          <else>
            <text macro="document"/>
          </else>
        </choose>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
